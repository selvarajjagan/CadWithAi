<Window x:Class="CadWithAi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CadWithAi"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:converters="clr-namespace:CadWithAi.Converters"
        mc:Ignorable="d"
        Title="WPF AI Integration - Order Management" Height="450" Width="800" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="70*"/>
        </Grid.ColumnDefinitions>

        <!-- RIGHT PANEL: AI Chat Mode -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="AI Interactive Assistant" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,10"/>

            <!-- Execution & Conversation Log -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Margin="0,0,0,10" Background="#FAFAFA" BorderBrush="#DDD">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="3" FontSize="13"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Input Box & Send Button -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding UserPrompt, UpdateSourceTrigger=PropertyChanged}" 
                         Height="40" VerticalContentAlignment="Center" Padding="8,0" FontSize="13">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SendAiMessageCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="1" Content="Send" Grid.ColumnSpan="2" Margin="10,0,0,0"
                        Command="{Binding SendAiMessageCommand}" 
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"
                        Background="#28A745" Foreground="White" FontWeight="Bold" Height="40"/>
            </Grid>
        </Grid>

        <Grid Grid.Column="2">
            <h:HelixViewport3D x:Name="hvp" Background="Silver" Loaded="HelixViewport3D_Loaded" ZoomExtentsWhenLoaded="True" ShowCoordinateSystem="False" ShowViewCube="True" />
        </Grid>
    </Grid>
</Window>